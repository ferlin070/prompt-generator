# ========================================
# Prompt Generator Pro - Environment Template
# ========================================
# Copy to .env and fill in real values before deploy.
# ========================================

# Vercel Postgres (auto-set by Vercel when you provision Postgres)
POSTGRES_URL=your-postgres-url

# JWT Secret (generate a random string)
JWT_SECRET=your-jwt-secret-min-32-chars

# Test account (used by test scripts)
SUPABASE_TEST_EMAIL=your-test-email@example.com
SUPABASE_TEST_PASSWORD=your-test-password

# Bayarcash Payment Gateway
BAYARCASH_API_TOKEN=your-bayarcash-token
BAYARCASH_API_SECRET_KEY=your-bayarcash-secret-key
BAYARCASH_PORTAL_KEY=your-bayarcash-portal-key
BAYARCASH_SANDBOX=true
